FROM nginx:1.25-alpine

WORKDIR /var/www/html

# Copy application code for PHP file existence checks and static assets.
COPY . /var/www/html

# Use production nginx config (expects upstream app service at app:9000).
COPY docker/nginx.prod.conf /etc/nginx/conf.d/default.conf

# Keep logs and PID in writable locations.
RUN mkdir -p /var/log/nginx /var/run/nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
