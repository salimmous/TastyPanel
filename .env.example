APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_MODE=platform
TENANT_MODE=false
TENANT_LOCK_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL - CloudPanel style)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tastypanel_platform
DB_USERNAME=tastypanel_admin
DB_PASSWORD=

# Legacy SQLite option (comment out MySQL above and uncomment below)
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/tastypanel/database/platform.sqlite


SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=redis

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_BASE_URL=https://api.openai.com/v1
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=
CANVA_SCOPES=design:meta:read asset:read asset:write folder:read comment:write
CANVA_AUTH_URL=https://www.canva.com/api/oauth/authorize
CANVA_TOKEN_URL=https://api.canva.com/rest/v1/oauth/token
CANVA_API_BASE=https://api.canva.com/rest/v1
DISCORD_API_BASE=https://discord.com/api/v10
PINTEREST_API_BASE=https://api.pinterest.com/v5

CLOUDFLARE_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DNS_TOKEN=
TENANT_TARGET_IP=127.0.0.1
SSL_AUTO=false
SSL_PROVIDER=letsencrypt
SSL_CERTBOT_PATH=certbot
SSL_CERTBOT_EMAIL=
SSL_PROPAGATION_SECONDS=30
AUTO_NGINX=false
NGINX_PROVISION_SCRIPT=/var/www/tastypanel/infrastructure/provision-nginx.sh
NGINX_USE_SUDO=true
NGINX_AVAILABLE_DIR=/etc/nginx/sites-available
NGINX_ENABLED_DIR=/etc/nginx/sites-enabled
NGINX_SAFE_DEPLOY_SCRIPT=/var/www/tastypanel/infrastructure/deploy-nginx-safe.sh
NGINX_SAFE_DEPLOY_USE_SUDO=true
NGINX_DEPLOY_BACKUP_ROOT=/var/backups/tastypanel-nginx
NGINX_ACCESS_LOG_TEMPLATE=/var/log/nginx/%s-access.log
NGINX_ERROR_LOG_TEMPLATE=/var/log/nginx/%s-error.log
PHP_FPM_LOG=/var/log/php8.3-fpm.log
SECURITY_SCAN_SCRIPT=/var/www/tastypanel/infrastructure/security-scan.sh
SECURITY_SCAN_USE_SUDO=true
SECURITY_AUDIT_SCRIPT=/var/www/tastypanel/infrastructure/security-audit.sh
FIREWALL_SCRIPT=/var/www/tastypanel/infrastructure/firewall-apply.sh
FIREWALL_USE_SUDO=true
TENANT_WEB_ROOT=/var/www/tastypanel/public
PHP_FPM_SOCKET=/run/php/php8.3-fpm.sock
TENANT_INSTANCES_ROOT=/var/www/tastypanel-sites
TENANT_APP_REPO=
TENANT_APP_BRANCH=main
TENANT_PHP_VERSION=8.3
INSTANCE_PROVISION_SCRIPT=/var/www/tastypanel/infrastructure/provision-instance.sh
INSTANCE_USE_SUDO=true
INSTANCE_DEPROVISION_SCRIPT=/var/www/tastypanel/infrastructure/deprovision-instance.sh
INSTANCE_DEPROVISION_USE_SUDO=true
INSTANCE_SYSTEM_USER_PREFIX=tbapp
INSTANCE_FPM_MAX_CHILDREN=10
INSTANCE_FPM_MAX_REQUESTS=500
INSTANCE_FPM_MEMORY_LIMIT_MB=256
INSTANCE_ORCHESTRATE_SCRIPT=/var/www/tastypanel/infrastructure/orchestrate-tenant.sh
INSTANCE_ORCHESTRATE_USE_SUDO=true
INSTANCE_CLONE_SCRIPT=/var/www/tastypanel/infrastructure/clone-tenant.sh
INSTANCE_CLONE_USE_SUDO=true
TENANT_ENV_SYNC_SCRIPT=/var/www/tastypanel/infrastructure/sync-tenant-env.sh
TENANT_ENV_SYNC_USE_SUDO=true
FRONTEND_AUTO=false
FRONTEND_PROVISION_SCRIPT=/var/www/tastypanel/infrastructure/provision-frontend.sh
FRONTEND_DEPROVISION_SCRIPT=/var/www/tastypanel/infrastructure/deprovision-frontend.sh
FRONTEND_PROVISION_USE_SUDO=true
FRONTEND_PLATFORM_API_BASE=https://platform.example.com/api
TENANT_ACCESS_SCRIPT=/var/www/tastypanel/infrastructure/provision-tenant-access.sh
TENANT_ACCESS_USE_SUDO=true
TENANT_ACCESS_AUTH_MODE=both
TENANT_ACCESS_SFTP_ONLY=false
TENANT_MAILBOX_SCRIPT=/var/www/tastypanel/infrastructure/manage-tenant-mailbox.sh
TENANT_MAILBOX_USE_SUDO=true
TENANT_MAILBOX_ROOT=/var/mail/tastypanel
TENANT_MAILBOX_USERS_FILE=/etc/dovecot/tastypanel-users
TENANT_MAILBOX_OS_USER=vmail
TENANT_MAILBOX_OS_GROUP=vmail
TENANT_MAIL_DEFAULT_DAILY_LIMIT=500
TENANT_MAIL_DEFAULT_PER_MINUTE_LIMIT=30
TENANT_BACKUP_ROOT=/var/www/tastypanel/storage/app/tenant-backups
TENANT_BACKUP_SCRIPT=/var/www/tastypanel/infrastructure/backup-tenant.sh
TENANT_RESTORE_SCRIPT=/var/www/tastypanel/infrastructure/restore-tenant.sh
TENANT_BACKUP_USE_SUDO=false
TENANT_QUEUE_SCRIPT=/var/www/tastypanel/infrastructure/queue-tenant.sh
TENANT_QUEUE_USE_SUDO=false
TENANT_FILES_ROOT=/var/www/tastypanel/storage/tenant-files
PANEL_ALLOWED_IPS=
PLATFORM_RATE_LIMIT=120
PLATFORM_SERVICE_MANAGER_SCRIPT=/var/www/tastypanel/infrastructure/manage-platform-service.sh
PLATFORM_SERVICE_MANAGER_USE_SUDO=true
PLATFORM_SERVICE_LOG_LINES=120
PLATFORM_SERVICE_NGINX=nginx
PLATFORM_SERVICE_PHP_FPM=php8.3-fpm
PLATFORM_SERVICE_DB=mysql
PLATFORM_SERVICE_REDIS=redis-server
PLATFORM_SERVICE_QUEUE=tastypanel-queue.service
PLATFORM_SERVICE_SCHEDULER=tastypanel-scheduler.service
PROVISIONING_LOCK_TTL_SECONDS=1800
AUTO_PROVISION_ON_TENANT_CREATE=false
PROMETHEUS_ENABLED=true
PROMETHEUS_TOKEN=

VITE_APP_NAME="${APP_NAME}"
VITE_APP_MODE=platform
