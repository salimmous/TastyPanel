# Fill and rename to .env.kamal
REGISTRY=registry.example.com
REGISTRY_USER=your_registry_user
REGISTRY_PASSWORD=your_registry_password
HOSTS=your.server.ip
SSH_USER=root

# App secrets (mirrors .env)
APP_KEY=
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tastypanel
DB_USERNAME=tastypanel
DB_PASSWORD=tastypanel123
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
APP_URL=http://your.server.ip
APP_MODE=platform
TENANT_MODE=false
AUTO_PROVISION_ON_TENANT_CREATE=false
TENANT_APP_REPO=
TENANT_APP_BRANCH=main
FRONTEND_AUTO=false

# Optional MySQL root password if provisioning accessory
DB_ROOT_PASSWORD=changeme_root
